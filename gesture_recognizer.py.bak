import numpy as np
from collections import deque
from typing import List, Tuple, Optional, Dict
import math


class GestureRecognizer:
    """
    Recognizes hand gestures from hand landmark positions over time.
    Supports circular motions and directional swipes.
    """
    
    def __init__(self, history_size=50, min_movement=0.05):
        """
        Args:
            history_size: Number of frames to keep in history
            min_movement: Minimum movement threshold to detect gestures
        """
        self.history_size = history_size
        self.min_movement = min_movement
        
        # Store hand position history (using wrist or palm center)
        self.position_history = deque(maxlen=history_size)
        
        # Debug mode
        self.debug = False
        
        # Current detected gesture
        self.current_gesture = None
        self.gesture_confidence = 0.0
        self.gesture_cooldown = 0
        self.cooldown_frames = 20  # Frames to wait before detecting new gesture
        
        # Generate gesture templates
        self.templates = self._generate_templates()
        
        # Minimum points needed for matching
        self.min_points_for_match = 20
        
    def add_hand_position(self, landmarks):
        """
        Add current hand landmarks to history.
        
        Args:
            landmarks: MediaPipe hand landmarks
        """
        if landmarks:
            # Use palm center (average of key palm points)
            wrist = landmarks[0]
            index_mcp = landmarks[5]
            pinky_mcp = landmarks[17]
            
            palm_center = (
                (wrist.x + index_mcp.x + pinky_mcp.x) / 3,
                (wrist.y + index_mcp.y + pinky_mcp.y) / 3,
                (wrist.z + index_mcp.z + pinky_mcp.z) / 3
            )
            
            self.position_history.append(palm_center)
    
    def _generate_templates(self) -> Dict[str, np.ndarray]:
        """Generate normalized templates for each gesture."""
        templates = {}
        
        # Clockwise circle (50 points)
        angles_cw = np.linspace(0, 2 * np.pi, 50)
        templates['CIRCLE_CLOCKWISE'] = np.column_stack([
            0.5 + 0.3 * np.cos(angles_cw),
            0.5 + 0.3 * np.sin(angles_cw)
        ])
        
        # Counter-clockwise circle (50 points)
        angles_ccw = np.linspace(0, -2 * np.pi, 50)
        templates['CIRCLE_COUNTER_CLOCKWISE'] = np.column_stack([
            0.5 + 0.3 * np.cos(angles_ccw),
            0.5 + 0.3 * np.sin(angles_ccw)
        ])
        
        # Triangle (60 points - 20 per side)
        triangle = []
        # Bottom side (left to right)
        for i in range(20):
            triangle.append([0.2 + 0.6 * i / 20, 0.7])
        # Right side (bottom to top)
        for i in range(20):
            t = i / 20
            triangle.append([0.8 - 0.3 * t, 0.7 - 0.5 * t])
        # Left side (top to bottom)
        for i in range(20):
            t = i / 20
            triangle.append([0.5 - 0.3 * t, 0.2 + 0.5 * t])
        templates['TRIANGLE'] = np.array(triangle)
        
        return templates
    
    def get_template(self, gesture_name: str) -> Optional[np.ndarray]:
        """Get the template for a specific gesture."""
        return self.templates.get(gesture_name)
    
    def _normalize_path(self, positions: np.ndarray) -> np.ndarray:
        """Normalize a path to [0, 1] range."""
        if len(positions) == 0:
            return positions
        
        min_vals = positions.min(axis=0)
        max_vals = positions.max(axis=0)
        
        # Avoid division by zero
        range_vals = max_vals - min_vals
        range_vals[range_vals < 1e-6] = 1.0
        
        normalized = (positions - min_vals) / range_vals
        return normalized
    
    def _resample_path(self, positions: np.ndarray, n_points: int) -> np.ndarray:
        """Resample path to have exactly n_points."""
        if len(positions) < 2:
            return positions
        
        # Calculate cumulative distances
        distances = np.sqrt(np.sum(np.diff(positions, axis=0)**2, axis=1))
        cumsum = np.concatenate([[0], np.cumsum(distances)])
        total_length = cumsum[-1]
        
        if total_length < 1e-6:
            return positions
        
        # Sample evenly along the path
        target_distances = np.linspace(0, total_length, n_points)
        resampled = []
        
        for target_dist in target_distances:
            idx = np.searchsorted(cumsum, target_dist)
            if idx == 0:
                resampled.append(positions[0])
            elif idx >= len(positions):
                resampled.append(positions[-1])
            else:
                # Interpolate between two points
                t = (target_dist - cumsum[idx - 1]) / (cumsum[idx] - cumsum[idx - 1])
                point = positions[idx - 1] + t * (positions[idx] - positions[idx - 1])
                resampled.append(point)
        
        return np.array(resampled)
    
    def _compute_similarity(self, path1: np.ndarray, path2: np.ndarray) -> float:
        """Compute similarity between two paths (0 = different, 1 = identical)."""
        if len(path1) != len(path2):
            return 0.0
        
        # Compute average distance between corresponding points
        distances = np.sqrt(np.sum((path1 - path2)**2, axis=1))
        avg_distance = np.mean(distances)
        
        # Convert distance to similarity (closer to 0 = more similar)
        # Use exponential decay
        similarity = np.exp(-avg_distance * 10)
        
        return similarity
    
    def detect_gesture(self) -> Tuple[Optional[str], float]:
        """
        Analyze position history using template matching.
        
        Returns:
            Tuple of (gesture_name, confidence)
        """
        # Manage cooldown
        if self.gesture_cooldown > 0:
            self.gesture_cooldown -= 1
            return self.current_gesture, self.gesture_confidence
        
        if len(self.position_history) < self.min_points_for_match:
            return None, 0.0
        
        # Convert history to numpy array (only x, y)
        positions = np.array([(p[0], p[1]) for p in self.position_history])
        
        # Check if movement is significant
        total_distance = np.sum(np.sqrt(np.sum(np.diff(positions, axis=0)**2, axis=1)))
        if total_distance < self.min_movement * 2:
            return None, 0.0
        
        # Normalize and resample the user's path
        normalized = self._normalize_path(positions)
        
        # Compare against all templates
        best_gesture = None
        best_similarity = 0.0
        
        for gesture_name, template in self.templates.items():
            # Resample user path to match template length
            resampled = self._resample_path(normalized, len(template))
            
            # Compute similarity
            similarity = self._compute_similarity(resampled, template)
            
            if similarity > best_similarity:
                best_similarity = similarity
                best_gesture = gesture_name
        
        # Need at least 40% similarity to detect
        if best_similarity > 0.4:
            self.current_gesture = best_gesture
            self.gesture_confidence = best_similarity
            self.gesture_cooldown = self.cooldown_frames
            return best_gesture, best_similarity
        
        # Decay current gesture if no strong detection
        if self.gesture_cooldown == 0:
            self.current_gesture = None
            self.gesture_confidence = 0.0
        
        return self.current_gesture, self.gesture_confidence
    
    def reset(self):
        """
        Detect circular motion (clockwise or counter-clockwise).
        
        Args:
            positions: Array of (x, y, z) positions
            
        Returns:
            Tuple of (gesture_name, confidence)
        """
        if len(positions) < 10:
            return None, 0.0
        
        # Use only x, y coordinates
        positions_2d = positions[:, :2]
        
        # Check if total movement is significant
        total_distance = np.sum(np.linalg.norm(np.diff(positions_2d, axis=0), axis=1))
        if total_distance < self.min_movement * 2:
            return None, 0.0
        
        # Calculate center of the path
        center = np.mean(positions_2d, axis=0)
        
        # Calculate angles from center
        angles = []
        for pos in positions_2d:
            dx = pos[0] - center[0]
            dy = pos[1] - center[1]
            angle = math.atan2(dy, dx)
            angles.append(angle)
        
        # Check if path is circular by measuring variance from mean radius
        radii = np.linalg.norm(positions_2d - center, axis=1)
        mean_radius = np.mean(radii)
        
        if mean_radius < 0.01:  # Too small (lowered for easier detection)
            return None, 0.0
        
        radius_variance = np.std(radii) / mean_radius
        
        # Low variance means more circular (reduced multiplier for more lenient detection)
        circularity = max(0, 1 - radius_variance * 1.5)
        
        if circularity < self.circular_threshold:
            if self.debug:
                print(f"[DEBUG] Not circular enough: {circularity:.2f} < {self.circular_threshold:.2f}")
            return None, 0.0
        
        # Determine direction by counting angle changes
        angle_changes = []
        for i in range(1, len(angles)):
            diff = angles[i] - angles[i-1]
            # Normalize to [-pi, pi]
            if diff > math.pi:
                diff -= 2 * math.pi
            elif diff < -math.pi:
                diff += 2 * math.pi
            angle_changes.append(diff)
        
        total_angle_change = sum(angle_changes)
        
        # Need significant rotation (at least half circle)
        if abs(total_angle_change) < math.pi * 0.6:
            if self.debug:
                print(f"[DEBUG] Not enough rotation: {abs(total_angle_change):.2f} < {math.pi * 0.6:.2f}")
            return None, 0.0
        
        if total_angle_change > 0:
            gesture = "CIRCLE_CLOCKWISE"
        else:
            gesture = "CIRCLE_COUNTER_CLOCKWISE"
        
        if self.debug:
            print(f"[DEBUG] Detected {gesture}! Confidence: {circularity:.2f}")
        
        return gesture, circularity
    
    def _detect_triangle(self, positions: np.ndarray) -> Tuple[Optional[str], float]:
        """
        Detect triangle gesture.
        
        Args:
            positions: Array of (x, y, z) positions
            
        Returns:
            Tuple of (gesture_name, confidence)
        """
        if len(positions) < 15:
            return None, 0.0
        
        # Use only x, y coordinates
        positions_2d = positions[:, :2]
        
        # Check if total movement is significant
        total_distance = np.sum(np.linalg.norm(np.diff(positions_2d, axis=0), axis=1))
        if total_distance < self.min_movement * 3:
            return None, 0.0
        
        # Check if path returns to start (closed shape)
        start_pos = positions_2d[0]
        end_pos = positions_2d[-1]
        closure_distance = np.linalg.norm(end_pos - start_pos)
        
        # Path should close (end near start) - relaxed for easier detection
        if closure_distance > 0.25:  # Not closed enough
            if self.debug:
                print(f"[DEBUG] Triangle not closed: {closure_distance:.2f} > 0.25")
            return None, 0.0
        
        # Find corners by detecting sharp angle changes
        corners = []
        window_size = 3  # Look at segments of this size
        angle_threshold = math.radians(100)  # Corners should have significant angle change
        
        for i in range(window_size, len(positions_2d) - window_size, 2):
            # Get vectors before and after this point
            vec_before = positions_2d[i] - positions_2d[i - window_size]
            vec_after = positions_2d[i + window_size] - positions_2d[i]
            
            # Calculate angle change
            len_before = np.linalg.norm(vec_before)
            len_after = np.linalg.norm(vec_after)
            
            if len_before < 1e-6 or len_after < 1e-6:
                continue
            
            # Normalize vectors
            vec_before = vec_before / len_before
            vec_after = vec_after / len_after
            
            # Calculate angle between vectors
            dot_product = np.clip(np.dot(vec_before, vec_after), -1.0, 1.0)
            angle = math.acos(dot_product)
            
            # If angle change is significant, this is a corner
            if angle > angle_threshold:
                # Make sure this corner is not too close to previous corners
                too_close = False
                for prev_corner in corners:
                    if abs(i - prev_corner) < window_size * 2:
                        too_close = True
                        break
                
                if not too_close:
                    corners.append(i)
        
        # Should have approximately 3 corners for a triangle
        num_corners = len(corners)
        
        if self.debug:
            print(f"[DEBUG] Triangle: found {num_corners} corners, closure: {closure_distance:.2f}")
        
        if num_corners < 2 or num_corners > 4:
            return None, 0.0
        
        # Calculate confidence based on how close to 3 corners and how well it closes
        corner_score = 1.0 - abs(num_corners - 3) * 0.3  # Penalty for not having exactly 3 corners
        closure_score = 1.0 - (closure_distance / 0.25)  # How well it closes
        
        confidence = (corner_score * 0.7 + closure_score * 0.3)
        confidence = max(0.0, min(1.0, confidence))
        
        if self.debug:
            print(f"[DEBUG] Triangle confidence: {confidence:.2f} (corners: {corner_score:.2f}, closure: {closure_score:.2f})")
        
        if confidence < 0.3:
            return None, 0.0
        
        if self.debug:
            print(f"[DEBUG] Detected TRIANGLE! Confidence: {confidence:.2f}")
        
        return "TRIANGLE", confidence
    
    def _detect_swipe(self, positions: np.ndarray) -> Tuple[Optional[str], float]:
        """
        Detect directional swipe gestures.
        
        Args:
            positions: Array of (x, y, z) positions
            
        Returns:
            Tuple of (gesture_name, confidence)
        """
        if len(positions) < 10:
            return None, 0.0
        
        # Calculate displacement from start to end
        start_pos = positions[0, :2]
        end_pos = positions[-1, :2]
        displacement = end_pos - start_pos
        
        distance = np.linalg.norm(displacement)
        
        if distance < self.swipe_threshold:
            return None, 0.0
        
        # Calculate path efficiency (straight line vs actual path)
        path_length = np.sum(np.linalg.norm(np.diff(positions[:, :2], axis=0), axis=1))
        efficiency = distance / (path_length + 1e-6)
        
        if efficiency < 0.4:  # Path is too curved for a swipe (lowered from 0.6)
            return None, 0.0
        
        # Calculate path curvature - swipes should have consistent direction
        if len(positions) > 5:
            movements = np.diff(positions[:, :2], axis=0)
            angles = []
            for move in movements:
                if np.linalg.norm(move) > 1e-6:
                    angle = math.atan2(move[1], move[0])
                    angles.append(angle)
            
            if len(angles) > 3:
                angle_std = np.std(angles)
                if angle_std > math.radians(40):  # Too much directional change for a swipe
                    return None, 0.0
        
        # Determine direction
        dx, dy = displacement
        angle = math.atan2(dy, dx)
        
        # Convert angle to direction
        # Right: 0, Down: pi/2, Left: pi, Up: -pi/2
        angle_deg = math.degrees(angle)
        
        confidence = min(1.0, distance / 0.3) * efficiency
        
        if -45 <= angle_deg < 45:
            return "SWIPE_RIGHT", confidence
        elif 45 <= angle_deg < 135:
            return "SWIPE_DOWN", confidence
        elif angle_deg >= 135 or angle_deg < -135:
            return "SWIPE_LEFT", confidence
        else:  # -135 <= angle_deg < -45
            return "SWIPE_UP", confidence
    
    def reset(self):
        """Reset gesture history and current detection."""
        self.position_history.clear()
        self.current_gesture = None
        self.gesture_confidence = 0.0
        self.gesture_cooldown = 0
    
    def get_gesture_description(self, gesture: str) -> str:
        """Get human-readable description of gesture."""
        descriptions = {
            "CIRCLE_CLOCKWISE": "Clockwise Circle",
            "CIRCLE_COUNTER_CLOCKWISE": "Counter-Clockwise Circle",
            "TRIANGLE": "Triangle",
            "SWIPE_LEFT": "Swipe Left",
            "SWIPE_RIGHT": "Swipe Right",
            "SWIPE_UP": "Swipe Up",
            "SWIPE_DOWN": "Swipe Down"
        }
        return descriptions.get(gesture, "Unknown")
